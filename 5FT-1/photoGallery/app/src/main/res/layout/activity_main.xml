<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_marginTop="30dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Switch
            android:id="@+id/flowerSwitch"
            style="@style/SwitchKategoria"
            android:text="Kwiaty" />
        <Switch
            android:id="@+id/animalSwitch"
            style="@style/SwitchKategoria"
            android:text="Zwierzęta" />
        <Switch
            android:id="@+id/carSwitch"
            style="@style/SwitchKategoria"
            android:text="Samochody" />
    </LinearLayout>
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2">
        <ImageView
            android:id="@+id/img1"
            style="@style/Zdjecie"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_height="150dp"
            android:src="@drawable/flower1"
            />
        <ImageView
            android:id="@+id/img2"
            style="@style/Zdjecie"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_height="150dp"
            android:src="@drawable/flower2"
            />
        <ImageView
            android:id="@+id/img3"
            style="@style/Zdjecie"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_height="150dp"
            android:src="@drawable/animal1"
            />
        <ImageView
            android:id="@+id/img4"
            style="@style/Zdjecie"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_height="150dp"
            android:src="@drawable/animal2"
            />
        <ImageView
            android:id="@+id/img5"
            style="@style/Zdjecie"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_height="150dp"
            android:src="@drawable/car1"
            />
        <ImageView
            android:id="@+id/img6"
            style="@style/Zdjecie"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_height="150dp"
            android:src="@drawable/car2"
            />

    </GridLayout>

</LinearLayout>